  "components": {
    "schemas": {
      "Actor": {
        "properties": {
          "room_id": {
            "type": "string",
            "minLength": 1,
            "title": "Room Id"
          },
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_id",
          "participant_id"
        ],
        "title": "Actor"
      },
      "AgentCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Kind"
          },
          "good_at": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Good At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "title": "AgentCreate"
      },
      "Assignment": {
        "properties": {
          "room_id": {
            "type": "string",
            "minLength": 1,
            "title": "Room Id"
          },
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id"
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "title": "Task Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_id",
          "participant_id",
          "task_id"
        ],
        "title": "Assignment"
      },
      "Delegation": {
        "properties": {
          "room_id": {
            "type": "string",
            "minLength": 1,
            "title": "Room Id"
          },
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id"
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "title": "Task Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "instructions": {
            "type": "string",
            "maxLength": 10000,
            "title": "Instructions",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_id",
          "participant_id",
          "task_id",
          "request_id"
        ],
        "title": "Delegation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "room_id": {
            "type": "string",
            "minLength": 1,
            "title": "Room Id"
          },
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
